admin.expresspharm.kz {
    reverse_proxy web-prod-a:3000 web-prod-b:3000 {
        lb_policy first
        lb_try_duration 2s
        health_uri /api/health
        health_interval 10s
        health_status 2xx
    }
}

admin-dev.expresspharm.kz {
    reverse_proxy web-dev-a:3000 web-dev-b:3000 {
        lb_policy first
        lb_try_duration 2s
        health_uri /api/health
        health_interval 10s
        health_status 2xx
    }
}
