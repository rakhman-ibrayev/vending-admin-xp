admin.expresspharm.kz {
    reverse_proxy web-prod:3000 {
        lb_policy first
        lb_try_duration 2s
        health_uri /api/health
        health_interval 10s
        health_status 2xx
    }
}

admin-dev.expresspharm.kz {
    reverse_proxy web-dev:3000 {
        lb_policy first
        lb_try_duration 2s
        health_uri /api/health
        health_interval 10s
        health_status 2xx
    }
}
